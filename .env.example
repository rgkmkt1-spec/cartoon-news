# Copy to .env for local runs. In GitHub, add each of these as a repository secret.

# Free script writer (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: comma-separated fallbacks, tried in order
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# gemini (default, free) | claude (uses Claude Code "claude -p" on this PC, counts against your Pro plan limits)
SCRIPT_PROVIDER=gemini

# Email notifications via Gmail (use an App Password, not your normal password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# YouTube upload: off | private | scheduled | public
#  off       -> no upload; you download the MP4 and upload yourself (use this until the API audit is approved)
#  private   -> uploads as private for you to review and publish
#  scheduled -> uploads private + auto-publishes after REVIEW_WINDOW_HOURS unless you set it private
YOUTUBE_MODE=off
REVIEW_WINDOW_HOURS=2
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Local Windows only, if Python isn't on PATH as "python"
# PYTHON=py

# AI lip sync (Wav2Lip). Set to off to use the simpler picture mouths.
LIPSYNC=ai
